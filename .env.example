# Hugging Face Access Token (Get yours free from https://huggingface.co/settings/tokens)
HF_TOKEN=your_huggingface_token_here
HUGGINGFACEHUB_API_TOKEN=your_huggingface_token_here

# Groq API Key (Get yours free from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# LangSmith Tracing (Optional for monitoring and debugging LLM calls)
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=langchain-learning

